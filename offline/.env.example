# ── Development (consumed by server.ts Node proxy) ────────────────────────────
# The Express proxy in server.ts forwards /fastapi/* → FASTAPI_URL/api/*
# Only used when running  npm run dev  locally.
FASTAPI_URL=http://127.0.0.1:8000

# ── Production (consumed by Vite client build) ─────────────────────────────────
# VITE_API_URL is baked into the static bundle at build time.
# Set this in Vercel → Project Settings → Environment Variables.
# Must point to the live Railway backend with /api suffix.
#
# Example:
# VITE_API_URL=https://offline-world-cup-predictor-production.up.railway.app/api
VITE_API_URL=https://offline-world-cup-predictor-production.up.railway.app/api

# ── AI & App ───────────────────────────────────────────────────────────────────
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=http://localhost:3000
