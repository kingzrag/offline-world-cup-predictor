# FastAPI backend URL — required for ML predictions.
# Set to the address where uvicorn is running.
FASTAPI_URL=http://127.0.0.1:8000

# Exposed to Vite client (must be prefixed with VITE_)
VITE_FASTAPI_URL=http://127.0.0.1:8000

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=AQ.Ab8RN6JgkEur-YU28K-BhPvli_dk0Z2IAXja8mrW97lKKRE6hg

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=http://localhost:3000
